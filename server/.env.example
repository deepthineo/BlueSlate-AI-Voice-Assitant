# ============================================================
# BLUESLATE SERVER — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=3001

# Supabase (free at supabase.com)
# Project Settings > API > URL and service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...your-service-role-key

# Clerk (free at clerk.com)
# Dashboard > API Keys
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Twilio (trial at twilio.com — $15.50 free credit)
# Console > Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+14695551234

# Groq (REQUIRED — free at console.groq.com, 14,400 req/day)
# Powers real-time voice responses (low latency).
GROQ_API_KEY=gsk_...

# Google Gemini (optional but recommended — free at aistudio.google.com)
# Powers the "Try BlueSlate" website scan, FAQ/sample-conversation generation,
# and knowledge-gap detection. Degrades gracefully to a fallback if omitted.
GEMINI_API_KEY=AIzaSy...

# Anthropic (optional — currently unused)
ANTHROPIC_API_KEY=

# ElevenLabs (optional — falls back to Twilio Polly TTS if empty)
# Free: 10,000 chars/month at elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# App URLs
# Development: use ngrok for SERVER_URL so Twilio can reach it
# Production: your Render URL
SERVER_URL=https://your-ngrok-url.ngrok.io
CLIENT_URL=http://localhost:5173
