# ============================================================
# BLUESLATE CLIENT — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Clerk (free at clerk.com)
# Dashboard > API Keys > Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# API URL
# Development: leave as /api (proxied by Vite to localhost:3001)
# Production: your Render server URL
VITE_API_URL=https://your-render-api.onrender.com/api

# WebSocket (for browser voice calls)
# Development: leave blank (defaults to ws://localhost:3001)
# Production: wss://your-render-api.onrender.com
VITE_WS_URL=wss://your-render-api.onrender.com
