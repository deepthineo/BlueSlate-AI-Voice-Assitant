# ============================================================
# BLUESLATE CLIENT — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Clerk (free at clerk.com)
# Dashboard > API Keys > Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# API URL
# Development: leave as /api (proxied by Vite to localhost:3001)
# Production: your Render server URL
VITE_API_URL=https://your-render-api.onrender.com/api

# WebSocket (for browser voice calls)
# Development: leave blank (defaults to ws://localhost:3001)
# Production: wss://your-render-api.onrender.com
VITE_WS_URL=wss://your-render-api.onrender.com

# ── Vapi (voice AI — powers "Talk to AI" + the inbound phone number) ──
# One assistant serves BOTH the phone number and the in-browser call.
# Public Key: Vapi Dashboard > Settings > API Keys > "Public Key" (safe in browser)
VITE_VAPI_PUBLIC_KEY=
# Assistant ID: Vapi Dashboard > Assistants > (your assistant) > copy ID.
# Must be the assistant assigned to your Vapi phone number (+1 980 265 4229).
VITE_VAPI_ASSISTANT_ID=
# Display number for click-to-call (the Vapi inbound number).
VITE_VAPI_PHONE=+1 980 265 4229
