# ============================================================
# BLUESLATE CLIENT — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Clerk (free at clerk.com)
# Dashboard > API Keys > Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# API URL
# Development: leave as /api (proxied by Vite to localhost:3001)
# Production: your Render server URL
VITE_API_URL=https://your-render-api.onrender.com/api

# WebSocket (for browser voice calls)
# Development: leave blank (defaults to ws://localhost:3001)
# Production: wss://your-render-api.onrender.com
VITE_WS_URL=wss://your-render-api.onrender.com

# ── Retell AI (voice AI — powers "Talk to AI" + the inbound phone number) ──
# The browser does NOT need the Retell API key — it requests a short-lived
# access token from the backend (/api/retell/web-call). The only thing the
# frontend needs is the display number for click-to-call.
# Must match the Retell inbound number (e.g. +1 570 747 4386).
VITE_RETELL_PHONE=+1 570 747 4386
